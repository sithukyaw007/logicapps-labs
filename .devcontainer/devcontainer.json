{
    "name": "Docusaurus editor codespace",
    "build": {
      "dockerfile": "Dockerfile"
    },
    "customizations": {
      "vscode": {
        "extensions": [
          "yzhang.markdown-all-in-one"
        ],
        "settings": {
          "files.exclude": {
            "**/CODE_OF_CONDUCT.md": true,
            "**/LICENSE": true
          }
        }
      }
    },
    "forwardPorts": [5000, 5001, 7071]
  }